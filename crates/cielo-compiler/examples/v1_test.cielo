effect Console { fn print(s: String) -> () }
effect LocalState { fn tick() -> Int }

struct Pair { a: Int, b: Int }
enum Option { Some(Int), None }

@comptime fn seed() -> Int {
  40 + 2
}

fn bump(x: Int) -> Int {
  x + 1
}

fn local_step(x: Int) -> Int with LocalState {
  do LocalState.tick();
  x + 3
}

fn io_step(x: Int) -> Int with Console {
  do Console.print("io_step");
  x + 5
}

fn main() -> Int {
  let base = seed();
  let forced = @runtime { base + 2 };
  let pair = Pair(base, forced);
  let opt = Some(base);
  let a = handle { local_step(base) } with LocalState {
    | tick() => 1
  };
  let b = handle { io_step(a) } with Console {
    | print(s) => 0
  };
  bump(b)
}
